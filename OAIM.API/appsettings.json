{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "restrictedToMinimumLevel": "Debug",
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "TenantSettings": {
    "Default": {
      "DBProvieor": "mssql",
      "ConnectionString": ""
    },
    "Tenants": [
      {
        "Name": "Tenant1",
        "TID": "Tenant1",
        "ConnectionString": ""
      },
      {
        "Name": "Tenant2",
        "TID": "Tenant2",
        "ConnectionString": ""
      },
      {
        "Name": "Tenant3",
        "TID": "Tenant3"
      }
    ]

  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryInMinutes": 36000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AdminSettings": {
    "Email": "",
    "Password": "",
    "TenantId": ""
  },
  "AllowedHosts": "*"
}
